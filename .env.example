# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Tasks, payments, workers, and proof images (GridFS) all live here.
# Indexes — including the unique partial index on payments.tx_hash that stops a
# settled Hedera transaction paying for two tasks — are created automatically on
# first connection.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=groundtruth

# ─── Hedera ───────────────────────────────────────────────────────────────────
# CAIP-2 network id. `hedera:testnet` or `hedera:mainnet`.
HEDERA_NETWORK=hedera:testnet

# Treasury account. Pays human oracles, funds the faucet, submits HCS messages.
# Get a funded testnet account from https://portal.hedera.com
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=

# Optional: force key parsing if auto-detection picks the wrong flavour.
# ECDSA (Hedera Portal default) or ED25519.
# HEDERA_KEY_TYPE=ECDSA

# Account payments are made out to. Defaults to HEDERA_OPERATOR_ID.
# PAY_TO_ACCOUNT=0.0.xxxxx

# The paying agent. Keep this SEPARATE from the treasury so the on-chain trail
# reads agent -> treasury -> worker (a real two-sided market) rather than one
# account paying itself. Must hold the payment asset.
AGENT_ACCOUNT_ID=0.0.yyyyy
AGENT_PRIVATE_KEY=

# HCS topic that verified proofs are anchored to.
# LEAVE THIS EMPTY on a fresh install: `pnpm hedera:setup` creates the topic and
# prints the id to paste here. A placeholder value here is truthy, so setup would
# report the topic as "already configured", create nothing, and every later
# anchor would fail against an id that does not exist.
HEDERA_PROOF_TOPIC_ID=

# ─── Payment asset ────────────────────────────────────────────────────────────
# Defaults to Circle USDC (testnet 0.0.429274 / mainnet 0.0.456858).
# Set to 0.0.0 to run the entire flow in native HBAR instead — decimals and
# symbol are then derived automatically, and no token association is required.
# PAYMENT_ASSET_ID=0.0.429274
# PAYMENT_ASSET_DECIMALS=6
# PAYMENT_ASSET_SYMBOL=USDC

# ─── x402 ─────────────────────────────────────────────────────────────────────
# A Hedera-capable facilitator is mandatory: it co-signs as fee payer and submits
# the payment. Both of these advertise `exact` on hedera:testnet.
#   https://api.testnet.blocky402.com   (blocky402, fee payer 0.0.7162784) — used for every
#                                        transaction linked in docs/VERIFICATION.md
#   https://x402.org/facilitator        (official) — advertises hedera:testnet but is NOT
#                                        exercised by our test runs
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_MAX_TIMEOUT_SECONDS=180

# Optional: override the public mirror node used for independent verification.
# HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_SECRET=your-admin-secret-key

# Secret used to sign short-lived proof-image URLs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to ADMIN_SECRET, but a dedicated secret is better.
PROOF_URL_SECRET=
PROOF_URL_TTL_SECONDS=3600

# Payment bypass for local demos. OFF unless BOTH of these are set, and refused
# outright in production — a reachable bypass on a payments API is a liability.
# ALLOW_DEMO_BYPASS=true

# Task price and the platform fee withheld from the oracle's payout (1200 = 12%).
ASP_PRICE_USDT=2.00
ASP_FEE_BPS=1200

# Faucet drip size and per-account cooldown (ms).
FAUCET_DRIP_AMOUNT=5.00
FAUCET_COOLDOWN_MS=3600000

# ─── AI ───────────────────────────────────────────────────────────────────────
# Used by the task planner and the semantic proof notary.
# Optional: without it the notary abstains and proofs are held for the paying
# agent to review rather than auto-paid — safe, just not autonomous.
GROQ_API_KEY=your-groq-api-key

# Vision model for photo proofs. Must be one your key can actually reach —
# check https://api.groq.com/openai/v1/models. Groq's catalogue changes, and a
# model that does not exist yields a 4xx that reads like an outage.
# Groq's catalogue changes; a model id that no longer exists returns a 4xx that reads like an
# outage. Check https://api.groq.com/openai/v1/models for what your key can reach.
VISION_MODEL=qwen/qwen3.6-27b

# A 429 or 5xx is retried with backoff before the proof is sent to manual
# review, which matters on a free tier.
VISION_RETRY_ATTEMPTS=3
VISION_RETRY_DELAY_MS=2000

# Optional: comma-separate VISION_API_KEY for several keys on one endpoint, or
# set VISION_FALLBACK to a JSON array of [{"url","key","model"}] providers tried
# in order. Both let a rate-limited vendor roll over automatically.
# VISION_API_KEY=
# VISION_FALLBACK=

# Confidence at or above which a model mismatch becomes a hard reject.
# Below it the notary abstains and the worker gets the benefit of the doubt.
NOTARY_REJECT_CONFIDENCE=0.6

# ─── Advanced ─────────────────────────────────────────────────────────────────
# Set to false to disable automatic payout — every verified proof then waits for
# the paying agent to accept it. The single biggest behavioural switch here.
AUTO_ACCEPT=true

# Payment bypass for local demos. Creates tasks with NO payment, so it needs this
# AND a matching ADMIN_SECRET, and is refused outright when NODE_ENV=production.
ALLOW_DEMO_BYPASS=false

# Notary / vision overrides. Leave unset unless you are pointing at a non-Groq,
# OpenAI-compatible endpoint.
# VISION_API_URL=
# VISION_API_KEY=
# VISION_MAX_TOKENS=1200
# VISION_FALLBACK=
# FORM_JUDGE_API_URL=
# FORM_JUDGE_API_KEY=
# FORM_JUDGE_MODEL=llama-3.3-70b-versatile

# Mirror-node lookup retry, and the treasury's per-transaction fee ceiling.
# MIRROR_LOOKUP_ATTEMPTS=6
# MIRROR_LOOKUP_DELAY_MS=1500
# HEDERA_MAX_TX_FEE_HBAR=2

# Proof image size cap (bytes) and the GridFS bucket name.
# PROOF_MAX_BYTES=15728640
# PROOF_BUCKET=proofs

# An independent oracle account for `pnpm e2e`. Without it the e2e pays the
# agent account back, which is not a real three-party trail.
# E2E_ORACLE_ACCOUNT=0.0.xxxxx
# Override the amount `pnpm e2e` pays (defaults to ASP_PRICE_USDT).
# E2E_BUDGET=

# Legacy alias for VISION_MODEL, kept so older configs keep working.
# GROQ_VISION_MODEL=
